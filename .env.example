# KidArtVault Configuration
# Copy to .env and customize before running with Docker Compose

# REQUIRED: Long random secret key for signing session cookies
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-hex-string-at-least-32-chars

# Timezone (used for timestamps & container logs)
TZ=Australia/Sydney

# Port exposed on the host (Synology NAS)
HOST_PORT=8080

# 'auto' (recommended) sets Secure cookies on HTTPS and allows HTTP on local NAS IP.
# Set to 'true' to strictly require HTTPS, or 'false' for HTTP only.
COOKIE_SECURE=auto

# Comma-separated allowed origins for CORS/CSRF origin checks (e.g. https://art.yourdomain.com)
# Leave empty if accessed via same-origin reverse proxy
ALLOWED_ORIGINS=

# Max upload size in megabytes (default 30MB for high-res phone photos)
MAX_UPLOAD_MB=30
